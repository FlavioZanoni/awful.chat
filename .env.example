# Copy to .env and fill in. The README's self-hosting section explains each
# variable; docker-compose.dokploy.yml is what reads them.

# ── Required ─────────────────────────────────────────────────────────────────

# Public domain of the instance (Traefik routes on it).
DOMAIN=example.com

# The server's public IP. The SFU and coturn announce it to clients.
ANNOUNCED_IP=203.0.113.10

# Relay API origin the frontend calls (/og, /klipy, /turn-credentials,
# /plugin-proxy).
VITE_API_URL=https://relay.example.com

# The relay's libp2p multiaddr, printed on relay boot.
VITE_RELAY_MULTIADDR=/dns4/relay.example.com/tcp/443/wss/p2p/12D3KooW...

# ── Optional ─────────────────────────────────────────────────────────────────

# SFU websocket URL. Defaults to /sfu on the app origin; dev uses
# http://localhost:3000.
#VITE_SFU_URL=

# Enables the GIF picker (klipy.co API key).
#KLIPY_API_KEY=

# Plugins fetched at build time; see frontend/plugins/README.md.
# Comma-separated GitHub repos, optionally pinned: owner/repo#ref
#PLUGIN_SOURCES=awful-org/awfully-awesome

# Hostnames plugins may reach through the relay's /plugin-proxy.
#PLUGIN_PROXY_HOSTS=api.steampowered.com,store.steampowered.com

# NAME@host=value list; plugins reference {{secret:NAME}}, substituted
# server-side only for that host.
#PLUGIN_PROXY_SECRETS=STEAM@api.steampowered.com=your-steam-api-key

# Switches TURN to short-lived HMAC credentials (see README hardening notes -
# coturn must be switched to --use-auth-secret with the same value).
#TURN_SECRET=

# Override the TURN URL list served to clients.
#TURN_URLS=

# TURN over TLS: certificate directory and the extra coturn args enabling it.
#TURN_TLS_DIR=
#TURN_TLS_ARGS=

# SFU WebRTC port range (defaults 40000-40499). Keep all four in sync and
# open in the firewall.
#RTC_MIN=40000
#RTC_MAX=40499
#PORTS_TCP=40000-40499:40000-40499/tcp
#PORTS_UDP=40000-40499:40000-40499/udp
